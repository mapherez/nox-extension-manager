{
  "manifest_version": 3,
  "name": "PurgeUndesirables",
  "version": "0.1.0",
  "description": "Selectively removes chosen domains from Chrome history and keeps future visits out of history.",
  "permissions": [
    "history",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PurgeUndesirables",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
